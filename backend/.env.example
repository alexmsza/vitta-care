# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database (used by both the db service and api service in docker-compose)
POSTGRES_USER=vitta_user
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=vitta_db

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Email (Lark Suite / SMTP)
MAIL_USERNAME=vittacareacessos@yourdomain.com
MAIL_PASSWORD=YOUR_SMTP_APP_PASSWORD
MAIL_FROM=vittacareacessos@yourdomain.com
MAIL_SERVER=smtp.larksuite.com
MAIL_PORT=465
MAIL_STARTTLS=False
MAIL_SSL_TLS=True

# Admin notification email
ADMIN_EMAIL=admin@yourdomain.com
